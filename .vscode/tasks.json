{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build Firmware",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "--project-dir",
        "${workspaceFolder}\\firmware"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Upload Firmware",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "--project-dir",
        "${workspaceFolder}\\firmware",
        "--target",
        "upload"
      ],
      "problemMatcher": []
    }
  ]
}